    <div class="form-group">
      <label class="form-label">목표 날짜</label>
      <input type="date" id="ddayDateInput" class="form-control">
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal('ddayModal')">닫기</button>
      <button class="btn btn-primary" onclick="saveDdaySettings()">저장</button>
    </div>
  </div>
</div>

<!-- 데이터 백업 / 복원 모달 -->
<div class="modal-backdrop" id="backupModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">💾 오프라인 데이터 백업 및 복원</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('backupModal')">✕</button>
    </div>
    <p style="font-size:13px;color:var(--text-sub);margin-bottom:14px;">
      현재 로그인된 닉네임 계정의 모든 타임테이블, 할 일, 회고 기록을 JSON 파일로 내보내거나 불러올 수 있습니다.
    </p>
    <div style="display:flex;flex-direction:column;gap:10px;">
      <button class="btn btn-primary" onclick="exportUserDataJSON()">⬇️ 현재 계정 데이터 파일(.json) 다운로드</button>
      <label class="btn btn-secondary" style="cursor:pointer;">
        ⬆️ 백업 파일(.json) 불러오기
        <input type="file" accept=".json" style="display:none;" onchange="importUserDataJSON(event)">
      </label>
    </div>
  </div>
</div>

<!-- ==========================================================================
     5. 애플리케이션 핵심 JavaScript 로직 (완전 오프라인 자립형)
     ========================================================================== -->
<script>
  // --------------------------------------------------------------------------
  // 전역 상태 및 상수 정의
  // --------------------------------------------------------------------------
  const STORAGE_PREFIX = "momentum_planner_user_";
  const PROFILES_KEY = "momentum_planner_profiles";
  const THEME_KEY = "momentum_planner_theme";

  let currentUser = null;
  let userData = null;
  let selectedDateStr = getTodayStr();
  let calViewYear = new Date().getFullYear();
  let calViewMonth = new Date().getMonth();
  let activeTimePart = "all"; // 'all', 'morning', 'afternoon', 'evening', 'dawn'

  // 타임테이블 모달 임시 상태
  let modalTrack = "plan";
  let modalCat = "study";

  // 타이머 상태
  let timerState = {
    running: false,
    paused: false,
    intervalId: null,
    startTimeStr: "09:00",
    endTimeStr: "09:00",
    elapsedSeconds: 0,
    targetSeconds: 0, // 0이면 스톱워치, >0이면 뽀모도로
    category: "study",
    subjectId: "math",
    title: "",
    focusTheme: "aurora",
    quote: "오늘의 몰입이 내일의 실력이 됩니다."
  };

  // 기본 과목 프리셋
  const DEFAULT_SUBJECTS = [
    { id: "kor", name: "국어", color: "#ef4444" },
    { id: "math", name: "수학", color: "#4f46e5" },
    { id: "eng", name: "영어", color: "#0ea5e9" },
    { id: "sci", name: "탐구/과학", color: "#10b981" },
    { id: "code", name: "코딩/전공", color: "#8b5cf6" },
    { id: "etc", name: "기타 자습", color: "#f59e0b" }
  ];

  // --------------------------------------------------------------------------
  // 유틸리티 함수 (날짜, 시간 변환, 토스트 알림)
  // --------------------------------------------------------------------------
  function getTodayStr() {
    const d = new Date();
    return formatDateISO(d);
  }

  function formatDateISO(d) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    return `${y}-${m}-${day}`;
  }

  function parseDateISO(str) {
    const [y, m, d] = str.split("-").map(Number);
    return new Date(y, m - 1, d);
  }

  function formatKoreanDate(str) {
    const d = parseDateISO(str);
    const days = ["일", "월", "화", "수", "목", "금", "토"];
    return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
  }

  function timeToMinutes(tStr) {
    if (!tStr) return 0;
    const [h, m] = tStr.split(":").map(Number);
    return h * 60 + m;
  }

  function minutesToTime(mins) {
    const clamped = Math.max(0, Math.min(1439, Math.round(mins)));
    const h = String(Math.floor(clamped / 60)).padStart(2, "0");
    const m = String(clamped % 60).padStart(2, "0");
    return `${h}:${m}`;
  }

  function formatDurationKor(mins) {
    const m = Math.max(0, Math.round(mins));
    const h = Math.floor(m / 60);
    const rem = m % 60;
    if (h === 0) return `${rem}분`;
    if (rem === 0) return `${h}시간`;
    return `${h}시간 ${rem}분`;
  }

  function getNowHHMM() {
    const now = new Date();
    return `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
  }

  function showToast(msg) {
    const container = document.getElementById("toastContainer");
    const el = document.createElement("div");
    el.className = "toast";
    el.textContent = msg;
    container.appendChild(el);
    setTimeout(() => {
      el.style.opacity = "0";
      el.style.transform = "translateY(8px)";
      setTimeout(() => el.remove(), 250);
    }, 2600);
  }

  // --------------------------------------------------------------------------
  // 1. 닉네임 기반 로그인 & 로컬 스토리지 영구 저장 시스템
  // --------------------------------------------------------------------------
  function initApp() {
    const savedTheme = localStorage.getItem(THEME_KEY) || "light";
    document.documentElement.setAttribute("data-theme", savedTheme);
    renderSavedProfiles();

    const lastUser = sessionStorage.getItem("momentum_active_session");
    if (lastUser) {
      loginUser(lastUser);
    }
  }

  function renderSavedProfiles() {
    const profiles = JSON.parse(localStorage.getItem(PROFILES_KEY) || "[]");
    const sec = document.getElementById("savedProfilesSection");
    const list = document.getElementById("profileChipsList");
    if (profiles.length === 0) {
      sec.style.display = "none";
      return;
    }
    sec.style.display = "block";
    list.innerHTML = profiles.map(name => `
      <button class="profile-chip" onclick="loginUser('${escapeHtml(name)}')">
        <span class="profile-avatar">${escapeHtml(name.charAt(0).toUpperCase())}</span>
        <span>${escapeHtml(name)}</span>
      </button>
    `).join("");
  }

  function loginWithInput() {
    const input = document.getElementById("nicknameInput");
    const name = input.value.trim();
    if (!name) {
      showToast("닉네임을 입력해주세요!");
      input.focus();
      return;
    }
    loginUser(name);
  }

  function loginUser(nickname) {
    currentUser = nickname;
    sessionStorage.setItem("momentum_active_session", nickname);

    // 프로필 목록에 등록
    let profiles = JSON.parse(localStorage.getItem(PROFILES_KEY) || "[]");
    if (!profiles.includes(nickname)) {
      profiles.push(nickname);
      localStorage.setItem(PROFILES_KEY, JSON.stringify(profiles));
    }

    // 사용자 전용 데이터 로드 또는 초기 샘플 생성
    const raw = localStorage.getItem(STORAGE_PREFIX + nickname);
    if (raw) {
      userData = JSON.parse(raw);
    } else {
      userData = createInitialUserData(nickname);
      saveUserData();
    }

    document.getElementById("loginScreen").style.display = "none";
    document.getElementById("mainApp").style.display = "block";
    document.getElementById("headerUserName").textContent = nickname;
    document.getElementById("headerUserAvatar").textContent = nickname.charAt(0).toUpperCase();

    const dObj = parseDateISO(selectedDateStr);
    calViewYear = dObj.getFullYear();
    calViewMonth = dObj.getMonth();

    refreshAllViews();
    showToast(`👋 '${nickname}'님의 플래너에 오신 것을 환영합니다!`);
  }

  function switchUser() {
    sessionStorage.removeItem("momentum_active_session");
    currentUser = null;
    document.getElementById("nicknameInput").value = "";
    renderSavedProfiles();
    document.getElementById("mainApp").style.display = "none";
    document.getElementById("loginScreen").style.display = "flex";
  }

  function createInitialUserData(nickname) {
    const today = getTodayStr();
    return {
      nickname,
      subjects: [...DEFAULT_SUBJECTS],
      dday: { title: "목표 시험일", date: "" },
      focusSettings: { theme: "aurora", quote: "오늘의 몰입이 내일의 실력이 됩니다." },
      days: {
        [today]: {
          blocks: [
            { id: "b1", track: "plan", category: "study", subjectId: "eng", title: "아침 영단어 & 독해", start: "07:30", end: "08:30" },
            { id: "b2", track: "plan", category: "school", subjectId: "etc", title: "학교 정규 수업 (오전)", start: "09:00", end: "12:00" },
            { id: "b3", track: "plan", category: "school", subjectId: "etc", title: "학교 정규 수업 (오후)", start: "13:00", end: "16:30" },
            { id: "b4", track: "plan", category: "study", subjectId: "math", title: "수학 미적분 문제풀이", start: "19:00", end: "21:30" },
            { id: "b5", track: "actual", category: "study", subjectId: "eng", title: "아침 영단어 암기 완료", start: "07:35", end: "08:30" },
            { id: "b6", track: "actual", category: "school", subjectId: "etc", title: "학교 정규 수업 (오전)", start: "09:00", end: "12:00" }
          ],
          todos: [
            { id: "t1", subjectId: "math", text: "수학 워크북 2단원 오답정리", done: false },
            { id: "t2", subjectId: "eng", text: "영어 모의고사 1회 시간 재고 풀기", done: true }
          ],
          memo: "",
          rating: 0
        }
      }
    };
  }

  function ensureDayRecord(dateStr) {
    if (!userData.days[dateStr]) {
      userData.days[dateStr] = { blocks: [], todos: [], memo: "", rating: 0 };
    }
    return userData.days[dateStr];
  }

  function saveUserData() {
    if (!currentUser || !userData) return;
    localStorage.setItem(STORAGE_PREFIX + currentUser, JSON.stringify(userData));
  }

  function toggleDarkMode() {
    const cur = document.documentElement.getAttribute("data-theme");
    const next = cur === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem(THEME_KEY, next);
  }

  // --------------------------------------------------------------------------
  // 2. 날짜 이동 및 뷰 전환
  // --------------------------------------------------------------------------
  function changeDate(delta) {
    const d = parseDateISO(selectedDateStr);
    d.setDate(d.getDate() + delta);
    selectedDateStr = formatDateISO(d);
    calViewYear = d.getFullYear();
    calViewMonth = d.getMonth();
    refreshAllViews();
  }

  function setSpecificDate(val) {
    if (!val) return;
    selectedDateStr = val;
    const d = parseDateISO(val);
    calViewYear = d.getFullYear();
    calViewMonth = d.getMonth();
    refreshAllViews();
  }

  function goToday() {
    selectedDateStr = getTodayStr();
    const d = parseDateISO(selectedDateStr);
    calViewYear = d.getFullYear();
    calViewMonth = d.getMonth();
    refreshAllViews();
  }

  function switchMainView(viewName) {
    document.querySelectorAll(".main-tab").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.view === viewName);
    });
    document.querySelectorAll(".view-section").forEach(sec => {
      sec.style.display = sec.id === `view-${viewName}` ? "block" : "none";
    });
    refreshAllViews();
  }

  function refreshAllViews() {
    document.getElementById("currentDateLabel").textContent = formatKoreanDate(selectedDateStr);
    document.getElementById("hiddenDatePicker").value = selectedDateStr;
    updateDdayHeader();
    populateSubjectSelects();
    renderSubjectLegend();
    updateTopStats();
    renderTodos();
    renderTimetable();
    renderDailyCalendar();
    renderDailyArchiveDetail();
    renderWeeklyView();
  }

  // --------------------------------------------------------------------------
  // 3. 상단 D-Day & 통계 집계 (개인 순공 vs 학교 시간 분리)
  // --------------------------------------------------------------------------
  function updateDdayHeader() {
    const badge = document.getElementById("ddayText");
    if (!userData.dday || !userData.dday.date) {
      badge.textContent = "목표 D-Day 설정";
      return;
    }
    const target = parseDateISO(userData.dday.date);
    const today = parseDateISO(getTodayStr());
    const diff = Math.round((target - today) / (1000 * 60 * 60 * 24));
    const dStr = diff === 0 ? "D-Day" : (diff > 0 ? `D-${diff}` : `D+${Math.abs(diff)}`);
    badge.textContent = `${userData.dday.title} (${dStr})`;
  }

  function saveDdaySettings() {
    const title = document.getElementById("ddayTitleInput").value.trim() || "목표일";
    const date = document.getElementById("ddayDateInput").value;
    userData.dday = { title, date };
    saveUserData();
    updateDdayHeader();
    closeModal("ddayModal");
    showToast("🎯 D-Day가 설정되었습니다.");
  }

  function calcDayMetrics(dateStr) {
    const rec = userData.days[dateStr];
    if (!rec) return { planStudy: 0, planSchool: 0, actualStudy: 0, actualSchool: 0 };
    let planStudy = 0, planSchool = 0, actualStudy = 0, actualSchool = 0;
    rec.blocks.forEach(b => {
      const dur = Math.max(0, timeToMinutes(b.end) - timeToMinutes(b.start));
      if (b.track === "plan") {
        if (b.category === "school") planSchool += dur;
        else planStudy += dur;
      } else {
        if (b.category === "school") actualSchool += dur;
        else actualStudy += dur;
      }
    });
    return { planStudy, planSchool, actualStudy, actualSchool };
  }

  function updateTopStats() {
    const m = calcDayMetrics(selectedDateStr);
    const rec = ensureDayRecord(selectedDateStr);

    document.getElementById("statSelfStudy").textContent = formatDurationKor(m.actualStudy);
    const studyRate = m.planStudy > 0 ? Math.round((m.actualStudy / m.planStudy) * 100) : (m.actualStudy > 0 ? 100 : 0);
    document.getElementById("statSelfPlanSub").textContent = `개인 공부 계획 대비 ${studyRate}%`;

    document.getElementById("statSchoolTime").textContent = formatDurationKor(m.actualSchool);

    const totalPlan = m.planStudy + m.planSchool;
    const totalActual = m.actualStudy + m.actualSchool;
    const overallRate = totalPlan > 0 ? Math.round((totalActual / totalPlan) * 100) : (totalActual > 0 ? 100 : 0);
    document.getElementById("statPlanRate").textContent = `${overallRate}%`;
    document.getElementById("statPlanTotalSub").textContent = `총 계획 ${formatDurationKor(totalPlan)}`;

    const doneCount = rec.todos.filter(t => t.done).length;
    document.getElementById("statTodoProgress").textContent = `${doneCount} / ${rec.todos.length}`;
    document.getElementById("statTodoSub").textContent = rec.todos.length === 0 ? "할 일을 추가해보세요" : `완료율 ${Math.round((doneCount / rec.todos.length) * 100)}%`;

    document.getElementById("planHeaderTotal").textContent = formatDurationKor(totalPlan);
    document.getElementById("actualHeaderTotal").textContent = formatDurationKor(totalActual);
  }

  // --------------------------------------------------------------------------
  // 4. 과목 관리 & 할 일(To-Do) 연동
  // --------------------------------------------------------------------------
  function getSubjectById(id) {
    return userData.subjects.find(s => s.id === id) || userData.subjects[0] || { id: "etc", name: "자습", color: "#4f46e5" };
  }

  function populateSubjectSelects() {
    const opts = userData.subjects.map(s => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join("");
    ["timerSubjectSelect", "todoSubjectSelect", "modalSubjectSelect"].forEach(elId => {
      const el = document.getElementById(elId);
      if (el) {
        const prev = el.value;
        el.innerHTML = opts;
        if (userData.subjects.some(s => s.id === prev)) el.value = prev;
      }
    });
  }

  function renderSubjectLegend() {
    const container = document.getElementById("subjectLegendList");
    container.innerHTML = userData.subjects.map(s => `
      <span class="subject-pill">
        <span style="width:10px;height:10px;border-radius:50%;background:${s.color};"></span>
        ${escapeHtml(s.name)}
      </span>
    `).join("");

    const manageList = document.getElementById("subjectManageList");
    if (manageList) {
      manageList.innerHTML = userData.subjects.map(s => `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:8px;background:var(--bg-subtle);border:1px solid var(--border-color);">
          <div style="display:flex;align-items:center;gap:8px;font-weight:700;font-size:13.5px;">
            <span style="width:14px;height:14px;border-radius:50%;background:${s.color};"></span>
            <span>${escapeHtml(s.name)}</span>
          </div>
          ${userData.subjects.length > 1 ? `<button class="btn btn-danger btn-sm" onclick="removeSubject('${s.id}')">삭제</button>` : ""}
        </div>
      `).join("");
    }
  }

  function addCustomSubject() {
    const nameInput = document.getElementById("newSubjectName");
    const colorInput = document.getElementById("newSubjectColor");
    const name = nameInput.value.trim();
    if (!name) return showToast("과목명을 입력하세요.");
    userData.subjects.push({
      id: "sub_" + Date.now(),
      name,
      color: colorInput.value
    });
    nameInput.value = "";
    saveUserData();
    refreshAllViews();
    showToast(`'${name}' 과목이 추가되었습니다.`);
  }

  function removeSubject(id) {
    userData.subjects = userData.subjects.filter(s => s.id !== id);
    saveUserData();
    refreshAllViews();
  }

  function addTodo() {
    const input = document.getElementById("todoTextInput");
    const subId = document.getElementById("todoSubjectSelect").value;
    const text = input.value.trim();
    if (!text) return;
    const rec = ensureDayRecord(selectedDateStr);
    rec.todos.push({ id: "td_" + Date.now(), subjectId: subId, text, done: false });
    input.value = "";
    saveUserData();
    renderTodos();
    updateTopStats();
  }

  function toggleTodo(id) {
    const rec = ensureDayRecord(selectedDateStr);
    const item = rec.todos.find(t => t.id === id);
    if (item) item.done = !item.done;
    saveUserData();
    renderTodos();
    updateTopStats();
  }

  function deleteTodo(id) {
    const rec = ensureDayRecord(selectedDateStr);
    rec.todos = rec.todos.filter(t => t.id !== id);
    saveUserData();
    renderTodos();
    updateTopStats();
  }

  function launchTimerFromTodo(id) {
    const rec = ensureDayRecord(selectedDateStr);
    const item = rec.todos.find(t => t.id === id);
    if (!item) return;
    document.getElementById("timerCategoryType").value = "study";
    toggleTimerSubjectSelect();
    document.getElementById("timerSubjectSelect").value = item.subjectId;
    document.getElementById("timerTaskInput").value = item.text;
    startFocusTimer();
  }

  function renderTodos() {
    const rec = ensureDayRecord(selectedDateStr);
    document.getElementById("todoBadgeCount").textContent = `${rec.todos.length}개`;
    const list = document.getElementById("todoListContainer");
    if (rec.todos.length === 0) {
      list.innerHTML = `<div style="text-align:center;padding:18px;font-size:12.5px;color:var(--text-muted);">등록된 할 일이 없습니다.<br>할 일을 추가하고 타이머와 연동해보세요!</div>`;
      return;
    }
    list.innerHTML = rec.todos.map(t => {
      const sub = getSubjectById(t.subjectId);
      return `
        <div class="todo-item ${t.done ? "done" : ""}">
          <input type="checkbox" class="todo-check" ${t.done ? "checked" : ""} onchange="toggleTodo('${t.id}')">
          <span class="todo-dot" style="background:${sub.color};" title="${escapeHtml(sub.name)}"></span>
          <span class="todo-text">${escapeHtml(t.text)}</span>
          <div class="todo-actions">
            <button class="mini-action" onclick="launchTimerFromTodo('${t.id}')" title="이 할 일로 타이머 시작">▶ 타이머</button>
            <button class="mini-action" onclick="deleteTodo('${t.id}')" title="삭제">✕</button>
          </div>
        </div>
      `;
    }).join("");
  }

  // --------------------------------------------------------------------------
  // 5. 아침 / 점심 / 저녁 3파트 분할 & 좌우 비교 타임테이블 렌더링
  // --------------------------------------------------------------------------
  function filterTimePart(part) {
    activeTimePart = part;
    document.querySelectorAll(".part-tab").forEach(b => {
      b.classList.toggle("active", b.dataset.part === part);
    });
    renderTimetable();
  }

  function renderTimetable() {
    const container = document.getElementById("timetablePartsContainer");
    const rec = ensureDayRecord(selectedDateStr);

    const parts = [
      { key: "morning", label: "🌅 아침 파트 (05:00 ~ 12:00)", startHour: 5, endHour: 12 },
      { key: "afternoon", label: "☀️ 점심 파트 (12:00 ~ 18:00)", startHour: 12, endHour: 18 },
      { key: "evening", label: "🌙 저녁 파트 (18:00 ~ 24:00)", startHour: 18, endHour: 24 },
      { key: "dawn", label: "🌌 심야 파트 (00:00 ~ 05:00)", startHour: 0, endHour: 5 }
    ];

    // '전체 보기'일 때는 아침/점심/저녁 3파트를 기본 노출 (심야 일정이 있으면 심야도 자동 표시)
    const hasDawnBlocks = rec.blocks.some(b => timeToMinutes(b.start) < 300);
    const visibleParts = parts.filter(p => {
      if (activeTimePart !== "all") return p.key === activeTimePart;
      if (p.key === "dawn") return hasDawnBlocks;
      return true;
    });

    const isToday = selectedDateStr === getTodayStr();
    const nowMins = timeToMinutes(getNowHHMM());

    container.innerHTML = visibleParts.map(part => {
      const pStartMin = part.startHour * 60;
      const pEndMin = part.endHour * 60;
      const hoursCount = part.endHour - part.startHour;
      const totalHeightPx = hoursCount * 48;

      let timeAxisHtml = "";
      let planSlotsHtml = "";
      let actualSlotsHtml = "";

      for (let h = part.startHour; h < part.endHour; h++) {
        const hh = String(h).padStart(2, "0") + ":00";
        timeAxisHtml += `<div class="hour-label">${String(h).padStart(2, "0")}시</div>`;
        planSlotsHtml += `<div class="hour-slot-bg" onclick="openScheduleModal('plan', '${hh}')" title="클릭하여 ${hh} 계획 추가"></div>`;
        actualSlotsHtml += `<div class="hour-slot-bg" onclick="openScheduleModal('actual', '${hh}')" title="클릭하여 ${hh} 실제 기록 추가"></div>`;
      }

      // 해당 파트 시간대에 겹치는 블록 렌더링
      const renderTrackBlocks = (trackName) => {
        return rec.blocks
          .filter(b => b.track === trackName)
          .map(b => {
            const bStart = timeToMinutes(b.start);
            const bEnd = timeToMinutes(b.end);
            const visStart = Math.max(bStart, pStartMin);
            const visEnd = Math.min(bEnd, pEndMin);
            if (visEnd <= visStart) return "";

            const topPx = (visStart - pStartMin) * 0.8;
            const heightPx = Math.max(18, (visEnd - visStart) * 0.8);
            const sub = getSubjectById(b.subjectId);
            const isSchool = b.category === "school";

            return `
              <div class="tt-block ${isSchool ? "is-school" : ""}"
                   style="top:${topPx}px; height:${heightPx}px; background:${isSchool ? "" : sub.color}; color:#ffffff;"
                   onclick="event.stopPropagation(); openEditScheduleModal('${b.id}')"
                   title="${escapeHtml(b.title)} (${b.start}~${b.end}) - 클릭하여 수정">
                <div class="tt-block-title">${isSchool ? "🏫 " : ""}${escapeHtml(b.title || sub.name)}</div>
                ${heightPx >= 30 ? `<div class="tt-block-time">${b.start} ~ ${b.end}</div>` : ""}
              </div>
            `;
          }).join("");
      };

      // 현재 시각 빨간 선
      let nowLineHtml = "";
      if (isToday && nowMins >= pStartMin && nowMins <= pEndMin) {
        const nowTop = (nowMins - pStartMin) * 0.8;
        nowLineHtml = `<div class="now-line" style="top:${nowTop}px;"></div>`;
      }

      return `
        <div class="tt-part-section">
          <div class="tt-part-banner">
            <span>${part.label}</span>
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);">빈 칸 클릭 시 일정 추가</span>
          </div>
          <div class="tt-body" style="height:${totalHeightPx}px;">
            <div class="time-axis">${timeAxisHtml}</div>
            <div class="track-column">
              ${planSlotsHtml}
              ${renderTrackBlocks("plan")}
              ${nowLineHtml}
            </div>
            <div class="track-column">
              ${actualSlotsHtml}
              ${renderTrackBlocks("actual")}
              ${nowLineHtml}
            </div>
          </div>
        </div>
      `;
    }).join("");
  }

  // --------------------------------------------------------------------------
  // 6. 일정 추가 / 수정 / 삭제 모달 로직
  // --------------------------------------------------------------------------
  function selectModalTrack(track) {
    modalTrack = track;
    document.getElementById("trackPlanCard").classList.toggle("selected", track === "plan");
    document.getElementById("trackActualCard").classList.toggle("selected", track === "actual");
  }

  function selectModalCat(cat) {
    modalCat = cat;
    document.getElementById("catStudyCard").classList.toggle("selected", cat === "study");
    document.getElementById("catSchoolCard").classList.toggle("selected", cat === "school");
    document.getElementById("modalSubjectGroup").style.display = cat === "study" ? "block" : "none";
  }

  function openScheduleModal(track, defaultStart) {
    document.getElementById("editBlockId").value = "";
    document.getElementById("scheduleModalTitle").textContent = track === "plan" ? "📋 새 계획 일정 추가" : "⚡ 실제 실행 기록 추가";
    document.getElementById("deleteBlockBtn").style.display = "none";
    selectModalTrack(track);
    selectModalCat("study");

    document.getElementById("modalTitleInput").value = "";
    document.getElementById("modalStartTime").value = defaultStart;
    const endMins = Math.min(1435, timeToMinutes(defaultStart) + 60);
    document.getElementById("modalEndTime").value = minutesToTime(endMins);
    openModal("scheduleModal");
  }

  function openEditScheduleModal(blockId) {
    const rec = ensureDayRecord(selectedDateStr);
    const b = rec.blocks.find(item => item.id === blockId);
    if (!b) return;

    document.getElementById("editBlockId").value = b.id;
    document.getElementById("scheduleModalTitle").textContent = "✏️ 일정 수정 / 삭제";
    document.getElementById("deleteBlockBtn").style.display = "inline-flex";
    selectModalTrack(b.track);
    selectModalCat(b.category);

    document.getElementById("modalSubjectSelect").value = b.subjectId;
    document.getElementById("modalTitleInput").value = b.title;
    document.getElementById("modalStartTime").value = b.start;
    document.getElementById("modalEndTime").value = b.end;
    openModal("scheduleModal");
  }

  function saveScheduleBlock() {
    const editId = document.getElementById("editBlockId").value;
    const subjectId = document.getElementById("modalSubjectSelect").value;
    const rawTitle = document.getElementById("modalTitleInput").value.trim();
    const start = document.getElementById("modalStartTime").value;
    const end = document.getElementById("modalEndTime").value;

    if (!start || !end || timeToMinutes(end) <= timeToMinutes(start)) {
      showToast("종료 시각은 시작 시각보다 늦어야 합니다.");
      return;
    }

    const sub = getSubjectById(subjectId);
    const title = rawTitle || (modalCat === "school" ? "학교 정규 수업" : sub.name);
    const rec = ensureDayRecord(selectedDateStr);

    if (editId) {
      const idx = rec.blocks.findIndex(b => b.id === editId);
      if (idx !== -1) {
        rec.blocks[idx] = { id: editId, track: modalTrack, category: modalCat, subjectId, title, start, end };
      }
      showToast("일정이 수정되었습니다.");
    } else {
      rec.blocks.push({
        id: "blk_" + Date.now(),
        track: modalTrack,
        category: modalCat,
        subjectId,
        title,
        start,
        end
      });
      showToast("일정이 추가되었습니다.");
    }

    saveUserData();
    closeModal("scheduleModal");
    refreshAllViews();
  }

  function deleteScheduleBlock() {
    const editId = document.getElementById("editBlockId").value;
    const rec = ensureDayRecord(selectedDateStr);
    rec.blocks = rec.blocks.filter(b => b.id !== editId);
    saveUserData();
    closeModal("scheduleModal");
    refreshAllViews();
    showToast("일정이 삭제되었습니다.");
  }

  // --------------------------------------------------------------------------
  // 7. 감성 풀스크린 공부 타이머 (시작/정지 시각 수정 & 자동 타임테이블 반영)
  // --------------------------------------------------------------------------
  function toggleTimerSubjectSelect() {
    const cat = document.getElementById("timerCategoryType").value;
    document.getElementById("timerSubjectSelect").style.display = cat === "study" ? "block" : "none";
  }

  function startFocusTimer() {
    const cat = document.getElementById("timerCategoryType").value;
    const subId = document.getElementById("timerSubjectSelect").value;
    const taskTitle = document.getElementById("timerTaskInput").value.trim();
    const mode = document.getElementById("timerModeSelect").value;

    const nowStr = getNowHHMM();
    timerState.running = true;
    timerState.paused = false;
    timerState.startTimeStr = nowStr;
    timerState.endTimeStr = nowStr;
    timerState.elapsedSeconds = 0;
    timerState.category = cat;
    timerState.subjectId = subId;
    timerState.title = taskTitle || (cat === "school" ? "학교 수업 집중" : getSubjectById(subId).name);
    timerState.targetSeconds = mode === "pomodoro25" ? 25 * 60 : (mode === "pomodoro50" ? 50 * 60 : 0);

    // 저장된 감성 테마 & 응원 문구 복원
    if (userData.focusSettings) {
      setFocusTheme(userData.focusSettings.theme || "aurora", false);
      timerState.quote = userData.focusSettings.quote || timerState.quote;
    }
    document.getElementById("focusQuoteDisplay").textContent = `"${timerState.quote}"`;

    const sub = getSubjectById(subId);
    document.getElementById("focusBadgeLabel").textContent = cat === "school" ? "🏫 학교 / 수업" : `📚 ${sub.name}`;
    document.getElementById("focusTaskLabel").textContent = timerState.title;
    document.getElementById("focusStartTimeInput").value = timerState.startTimeStr;
    document.getElementById("focusEndTimeInput").value = timerState.endTimeStr;
    document.getElementById("focusPauseBtn").textContent = "⏸ 일시정지";

    updateFocusClockUI();
    document.getElementById("focusOverlay").classList.add("active");

    clearInterval(timerState.intervalId);
    timerState.intervalId = setInterval(() => {
      if (!timerState.paused) {
        timerState.elapsedSeconds++;
        timerState.endTimeStr = getNowHHMM();
        document.getElementById("focusEndTimeInput").value = timerState.endTimeStr;
        updateFocusClockUI();
      }
    }, 1000);
  }

  function updateFocusClockUI() {
    let displaySec = timerState.elapsedSeconds;
    if (timerState.targetSeconds > 0) {
      displaySec = Math.max(0, timerState.targetSeconds - timerState.elapsedSeconds);
    }
    const h = String(Math.floor(displaySec / 3600)).padStart(2, "0");
    const m = String(Math.floor((displaySec % 3600) / 60)).padStart(2, "0");
    const s = String(displaySec % 60).padStart(2, "0");
    document.getElementById("focusClockDisplay").textContent = `${h}:${m}:${s}`;

    const diffMins = Math.max(0, timeToMinutes(timerState.endTimeStr) - timeToMinutes(timerState.startTimeStr));
    const activeMins = Math.max(diffMins, Math.floor(timerState.elapsedSeconds / 60));
    document.getElementById("focusCalculatedDuration").textContent = `반영 예정 시간: ${formatDurationKor(activeMins)}`;
  }

  function toggleFocusPause() {
    timerState.paused = !timerState.paused;
    const btn = document.getElementById("focusPauseBtn");
    btn.textContent = timerState.paused ? "▶ 다시 시작" : "⏸ 일시정지";
    if (timerState.paused) {
      showToast("일시정지됨: 시작/종료 시각을 자유롭게 수정할 수 있습니다.");
    }
  }

  function onFocusTimeManualEdit() {
    // 사용자가 직접 시작/정지 시각을 수정하면 즉시 반영
    timerState.paused = true;
    document.getElementById("focusPauseBtn").textContent = "▶ 다시 시작";
    timerState.startTimeStr = document.getElementById("focusStartTimeInput").value;
    timerState.endTimeStr = document.getElementById("focusEndTimeInput").value;
    const diffMins = Math.max(0, timeToMinutes(timerState.endTimeStr) - timeToMinutes(timerState.startTimeStr));
    timerState.elapsedSeconds = diffMins * 60;
    updateFocusClockUI();
  }

  function setFocusTheme(themeName, persist = true) {
    const overlay = document.getElementById("focusOverlay");
    overlay.className = `active theme-${themeName}`;
    document.querySelectorAll(".f-theme-btn[data-ftheme]").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.ftheme === themeName);
    });
    if (persist && userData) {
      userData.focusSettings.theme = themeName;
      saveUserData();
    }
  }

  function editFocusQuote() {
    // alert/prompt 대신 인라인 입력 전환
    const box = document.getElementById("focusQuoteDisplay");
    if (box.querySelector("input")) return;
    const cur = timerState.quote;
    box.innerHTML = `<input type="text" id="quoteInlineInput" value="${escapeHtml(cur)}" style="background:rgba(255,255,255,0.2);border:1px solid #fff;border-radius:6px;padding:4px 10px;color:inherit;font-size:14px;width:280px;text-align:center;" onkeydown="if(event.key==='Enter') saveFocusQuote()">`;
    const inp = document.getElementById("quoteInlineInput");
    inp.focus();
    inp.onblur = saveFocusQuote;
  }

  function saveFocusQuote() {
    const inp = document.getElementById("quoteInlineInput");
    if (!inp) return;
    const val = inp.value.trim() || "오늘의 몰입이 내일의 실력이 됩니다.";
    timerState.quote = val;
    userData.focusSettings.quote = val;
    saveUserData();
    document.getElementById("focusQuoteDisplay").textContent = `"${val}"`;
  }

  function finishAndSaveTimer() {
    clearInterval(timerState.intervalId);
    const startStr = document.getElementById("focusStartTimeInput").value || timerState.startTimeStr;
    let endStr = document.getElementById("focusEndTimeInput").value || timerState.endTimeStr;

    // 1분 미만 측정 시 최소 1분 블록으로 보정하여 타임테이블에 가시화
    if (timeToMinutes(endStr) <= timeToMinutes(startStr)) {
      const addMins = Math.max(1, Math.round(timerState.elapsedSeconds / 60));
      endStr = minutesToTime(timeToMinutes(startStr) + addMins);
    }

    const rec = ensureDayRecord(selectedDateStr);
    rec.blocks.push({
      id: "tmr_" + Date.now(),
      track: "actual",
      category: timerState.category,
      subjectId: timerState.subjectId,
      title: timerState.title,
      start: startStr,
      end: endStr
    });

    saveUserData();
    document.getElementById("focusOverlay").classList.remove("active");
    refreshAllViews();
    showToast(`✅ ${startStr}~${endStr} 공부 기록이 실제 타임테이블에 저장되었습니다!`);
  }

  function cancelFocusTimer() {
    clearInterval(timerState.intervalId);
    document.getElementById("focusOverlay").classList.remove("active");
  }

  // --------------------------------------------------------------------------
  // 8. 1일 기록 모아보기 & 공부 시간 농도 히트맵(잔디 심기) 달력
  // --------------------------------------------------------------------------
  function getHeatLevel(studyMinutes) {
    if (studyMinutes <= 0) return 0;
    if (studyMinutes < 120) return 1; // 2시간 미만
    if (studyMinutes < 240) return 2; // 2~4시간
    if (studyMinutes < 360) return 3; // 4~6시간
    return 4;                         // 6시간 이상 최고 농도
  }

  function changeCalMonth(delta) {
    calViewMonth += delta;
    if (calViewMonth < 0) { calViewMonth = 11; calViewYear--; }
    if (calViewMonth > 11) { calViewMonth = 0; calViewYear++; }
    renderDailyCalendar();
  }

  function renderDailyCalendar() {
    document.getElementById("calMonthTitle").textContent = `${calViewYear}년 ${calViewMonth + 1}월`;
    const grid = document.getElementById("calendarDaysGrid");

    const firstDay = new Date(calViewYear, calViewMonth, 1).getDay();
    const daysInMonth = new Date(calViewYear, calViewMonth + 1, 0).getDate();

    let html = "";
    for (let i = 0; i < firstDay; i++) {
      html += `<div class="cal-cell empty"></div>`;
    }

    for (let d = 1; d <= daysInMonth; d++) {
      const dateStr = `${calViewYear}-${String(calViewMonth + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
      const metrics = calcDayMetrics(dateStr);
      const lv = getHeatLevel(metrics.actualStudy);
      const isSelected = dateStr === selectedDateStr;
      const hrsText = metrics.actualStudy > 0 ? `${(metrics.actualStudy / 60).toFixed(1)}h` : "";

      html += `
        <div class="cal-cell heat-lv-${lv} ${isSelected ? "selected" : ""}"
             onclick="selectCalendarDate('${dateStr}')"
             title="${dateStr} | 개인 순공: ${formatDurationKor(metrics.actualStudy)}">
          <span class="cal-day-num">${d}</span>
          <span class="cal-study-hrs">${hrsText}</span>
        </div>
      `;
    }
    grid.innerHTML = html;
  }

  function selectCalendarDate(dateStr) {
    selectedDateStr = dateStr;
    refreshAllViews();
  }

  function renderDailyArchiveDetail() {
    document.getElementById("archiveDateTitle").textContent = `📅 ${formatKoreanDate(selectedDateStr)} 기록`;
    const m = calcDayMetrics(selectedDateStr);
    const rec = ensureDayRecord(selectedDateStr);

    document.getElementById("archiveSelfStudy").textContent = formatDurationKor(m.actualStudy);
    document.getElementById("archiveSchoolTime").textContent = formatDurationKor(m.actualSchool);

    // 과목별 합산
    const subMap = {};
    rec.blocks.filter(b => b.track === "actual" && b.category === "study").forEach(b => {
      const dur = Math.max(0, timeToMinutes(b.end) - timeToMinutes(b.start));
      subMap[b.subjectId] = (subMap[b.subjectId] || 0) + dur;
    });

    const breakdownEl = document.getElementById("archiveSubjectBreakdown");
    const entries = Object.entries(subMap);
    if (entries.length === 0) {
      breakdownEl.innerHTML = `<span style="font-size:12.5px;color:var(--text-muted);">기록된 개인 공부 내역이 없습니다.</span>`;
    } else {
      breakdownEl.innerHTML = entries.map(([subId, mins]) => {
        const sub = getSubjectById(subId);
        return `<span class="badge" style="background:${sub.color};color:#fff;padding:5px 10px;">${escapeHtml(sub.name)}: ${formatDurationKor(mins)}</span>`;
      }).join("");
    }

    document.getElementById("dailyMemoInput").value = rec.memo || "";
    updateStarUI(rec.rating || 0);
  }

  function setDailyRating(star) {
    const rec = ensureDayRecord(selectedDateStr);
    rec.rating = star;
    updateStarUI(star);
  }

  function updateStarUI(rating) {
    document.querySelectorAll("#starRatingGroup .star-btn").forEach(btn => {
      btn.classList.toggle("active", Number(btn.dataset.star) <= rating);
    });
  }

  function saveDailyReflection() {
    const rec = ensureDayRecord(selectedDateStr);
    rec.memo = document.getElementById("dailyMemoInput").value;
    saveUserData();
    showToast("📝 오늘의 학습 회고와 별점이 저장되었습니다.");
  }

  // --------------------------------------------------------------------------
  // 9. 1주일 계획 & 시간 모아보기 뷰
  // --------------------------------------------------------------------------
  function getWeekDates(baseDateStr) {
    const d = parseDateISO(baseDateStr);
    const day = d.getDay(); // 0(일) ~ 6(토)
    const diffToMon = day === 0 ? -6 : 1 - day;
    const monday = new Date(d);
    monday.setDate(d.getDate() + diffToMon);

    const list = [];
    for (let i = 0; i < 7; i++) {
      const cur = new Date(monday);
      cur.setDate(monday.getDate() + i);
      list.push(formatDateISO(cur));
    }
    return list;
  }

  function renderWeeklyView() {
    const weekDates = getWeekDates(selectedDateStr);
    const dayNames = ["월", "화", "수", "목", "금", "토", "일"];
    document.getElementById("weeklyRangeTitle").textContent = `📊 주간 학습 리포트 (${weekDates[0]} ~ ${weekDates[6]})`;

    let totalSelf = 0;
    let totalSchool = 0;
    let maxTotalMins = 60; // 최소 스케일 기준

    const dailyStats = weekDates.map((dStr, idx) => {
      const m = calcDayMetrics(dStr);
      totalSelf += m.actualStudy;
      totalSchool += m.actualSchool;
      maxTotalMins = Math.max(maxTotalMins, m.actualStudy + m.actualSchool);
      return { dateStr: dStr, dayName: dayNames[idx], ...m };
    });

    document.getElementById("weekTotalSelfBadge").textContent = `주간 개인 순공: ${formatDurationKor(totalSelf)}`;
    document.getElementById("weekTotalSchoolBadge").textContent = `주간 학교 시간: ${formatDurationKor(totalSchool)}`;

    // 막대 그래프 렌더링
    const chartEl = document.getElementById("weeklyBarChart");
    chartEl.innerHTML = dailyStats.map(st => {
      const studyPct = Math.round((st.actualStudy / maxTotalMins) * 100);
      const schoolPct = Math.round((st.actualSchool / maxTotalMins) * 100);
      const totalH = ((st.actualStudy + st.actualSchool) / 60).toFixed(1);
      return `
        <div class="week-bar-col">
          <div class="bar-label-top">${totalH}h</div>
          <div class="bar-stack" style="height:125px;">
            <div class="bar-study" style="height:${studyPct}%;" title="개인 순공: ${formatDurationKor(st.actualStudy)}"></div>
            <div class="bar-school" style="height:${schoolPct}%;" title="학교 시간: ${formatDurationKor(st.actualSchool)}"></div>
          </div>
          <div class="bar-day-name">${st.dayName} (${st.dateStr.slice(8)}일)</div>
        </div>
      `;
    }).join("");

    // 요일별 계획 및 농도 카드 렌더링
    const cardsEl = document.getElementById("weeklyDaysCards");
    cardsEl.innerHTML = dailyStats.map(st => {
      const rec = userData.days[st.dateStr] || { blocks: [], todos: [] };
      const lv = getHeatLevel(st.actualStudy);
      const planBlocks = rec.blocks.filter(b => b.track === "plan");

      return `
        <div class="week-day-card heat-lv-${lv}" onclick="jumpToDayFromWeekly('${st.dateStr}')">
          <div class="week-day-head">
            <span>${st.dayName}요일 (${st.dateStr.slice(5)})</span>
            <span>순공 ${(st.actualStudy / 60).toFixed(1)}h</span>
          </div>
          ${planBlocks.length === 0
            ? `<div style="font-size:11.5px;opacity:0.75;margin-top:6px;">등록된 계획 없음</div>`
            : planBlocks.slice(0, 4).map(b => `
                <div class="week-plan-chip">
                  ${b.category === "school" ? "🏫" : "📌"} ${b.start} ${escapeHtml(b.title)}
                </div>
              `).join("")
          }
          ${planBlocks.length > 4 ? `<div style="font-size:11px;font-weight:700;">+${planBlocks.length - 4}개 더보기</div>` : ""}
        </div>
      `;
    }).join("");
  }

  function jumpToDayFromWeekly(dateStr) {
    selectedDateStr = dateStr;
    switchMainView("today");
  }

  // --------------------------------------------------------------------------
  // 10. 모달 제어 & 데이터 JSON 백업/복원 & XSS 방지
  // --------------------------------------------------------------------------
  function openModal(id) {
    if (id === "ddayModal" && userData.dday) {
      document.getElementById("ddayTitleInput").value = userData.dday.title || "";
      document.getElementById("ddayDateInput").value = userData.dday.date || "";
    }
    document.getElementById(id).classList.add("open");
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove("open");
  }

  function exportUserDataJSON() {
    const blob = new Blob([JSON.stringify(userData, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `momentum_planner_${currentUser}_${getTodayStr()}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast("💾 백업 JSON 파일이 다운로드되었습니다.");
  }

  function importUserDataJSON(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const parsed = JSON.parse(e.target.result);
        if (!parsed.days || !parsed.subjects) throw new Error("올바르지 않은 백업 파일 형식입니다.");
        userData = parsed;
        userData.nickname = currentUser;
        saveUserData();
        refreshAllViews();
        closeModal("backupModal");
        showToast("✅ 백업 데이터가 성공적으로 복원되었습니다!");
      } catch (err) {
        showToast("❌ 파일을 불러오는 데 실패했습니다.");
      }
    };
    reader.readAsText(file);
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // 윈도우 로드 시 초기화
  window.addEventListener("DOMContentLoaded", initApp);
</script>
</body>
</html>
