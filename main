      <input type="text" id="newSubjectName" class="form-control" placeholder="새 과목명 (예: 한국사)">
      <div style="display:flex;gap:6px;">
        <input type="color" id="newSubjectColor" value="#6366f1" style="width:46px;height:38px;border:none;background:none;cursor:pointer;">
        <button class="btn btn-primary" style="flex:1;" onclick="addCustomSubject()">과목 추가</button>
      </div>
    </div>
    <div id="subjectManageList" style="display:flex;flex-direction:column;gap:8px;max-height:260px;overflow-y:auto;"></div>
  </div>
</div>

<!-- D-Day 설정 모달 -->
<div class="modal-backdrop" id="ddayModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">🎯 목표 D-Day 설정</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('ddayModal')">✕</button>
    </div>
